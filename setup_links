#!/bin/bash

BASE_LINK_PATH=$HOME/.local/bin/

# Check if directory exists and create if it doesn't
if [[ ! -d $BASE_LINK_PATH ]]; then
	mkdir -p "$BASE_LINK_PATH"
fi

# Anchor to the repo rather than to $(pwd). Nothing forces the caller into this
# directory, and from anywhere else `find .` walks that tree instead and
# publishes all of it into ~/.local/bin.
REPO_ROOT=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd -P)

mapfile -d '' -t items < <(find "$REPO_ROOT" -type f -executable -printf '%P\0' | grep -z -v -E "\.git|simple_wp_plugin|setup_links")

if [[ $1 == "-d" ]]; then
  read -r -p "Are you sure you want to delete all the links? (Y/N) " test
  check=$(echo "$test" | tr '[:lower:]' '[:upper:]')
  if [[ $check == "Y" ]]; then
    for i in "${items[@]}"; do
      LINK_PATH=$BASE_LINK_PATH$(basename "$i" | sed 's/\.[^.]*$//')
      echo "Deleting ... $LINK_PATH"
      rm -f "$LINK_PATH"
    done
  fi
  exit
fi

for i in "${items[@]}"; do
  LINK_PATH=$BASE_LINK_PATH$(basename "$i" | sed 's/\.[^.]*$//')
  CREATE=1
  if [ -L "$LINK_PATH" ]; then
    read -r -p "Do you want to recreate: $LINK_PATH? (Y/N) " test
    check=$(echo "$test" | tr '[:lower:]' '[:upper:]')
    if [[ $check == "Y" ]]; then
      echo "Deleting ... $LINK_PATH"
      rm -f "$LINK_PATH"
    else
      CREATE=0
    fi
  fi	  
  if [[ $CREATE -eq 1 ]]; then 
    echo "Creating ... $REPO_ROOT/$i->$LINK_PATH"
    ln -s "$REPO_ROOT/$i" "$LINK_PATH"
  fi
done
