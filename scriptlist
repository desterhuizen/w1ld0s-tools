#!/bin/bash
#
# scriptlist - Display a list of available penetration testing scripts
#
# This script shows an organized list of all tools in the w1ld0s-tools repository
# with options for filtering and displaying details.

# Self-locating: $W1LD0S_TOOLS_DIR wins so a checkout anywhere still works,
# otherwise follow the ~/.local/bin symlink setup_links makes back to this
# file, whose own directory is the repo root.
SCRIPT_DIR="${W1LD0S_TOOLS_DIR:-$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd -P)}"
VERSION="1.0.0"

# Define colors for better readability
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Function to display help information
function show_help() {
    cat << EOF
Usage: scriptlist [OPTIONS] [SEARCH_TERM]

Options:
  -h, --help       Display this help message
  -c, --category   List scripts by category
  -d, --details    Show detailed descriptions for each script
  -f, --find       Find scripts matching a specific term
  -v, --version    Display version information

Examples:
  scriptlist                   Show all scripts
  scriptlist -c                List scripts by category
  scriptlist -f exploit        Find all scripts with 'exploit' in the name
  scriptlist -d                Show details for all scripts
  scriptlist -c -f payload     List categorized scripts containing 'payload'

EOF
    exit 0
}

# Function to display version information
function show_version() {
    echo -e "${BLUE}scriptlist${NC} version ${GREEN}${VERSION}${NC}"
    echo "Part of the w1ld0s-tools collection"
    exit 0
}

# Function to display scripts by category
function show_by_category() {
    local search_term="$1"

    echo -e "${GREEN}=================================================${NC}"
    echo -e "${GREEN}=  PENETRATION TESTING SCRIPTS BY CATEGORY      =${NC}"
    echo -e "${GREEN}=================================================${NC}"

    # One category per top-level directory, so this list cannot drift from the
    # tree the way the old hand-maintained mapping did. Runtime state
    # (engagement/*/config, attack/attacker) and the frozen legacy bash are
    # filtered out -- they are not tools.

    # Core Tools -- the commands that live at the repo root
    echo -e "\n${YELLOW}=== CORE TOOLS ===${NC}"
    find "$SCRIPT_DIR" -maxdepth 1 -type f -not -path "*/\.*" | grep -v "README.md\|LICENSE\|NOTICE\|CLAUDE" | sort | grep -i "$search_term" || true

    # Engagement State
    echo -e "\n${YELLOW}=== ENGAGEMENT STATE ===${NC}"
    find "$SCRIPT_DIR/engagement" -type f -not -path "*/\.*" -not -path "*/legacy/*" -not -path "*/config/*" -not -name "attacker" 2>/dev/null | sort | grep -i "$search_term" || true

    # Scanning and Enumeration
    echo -e "\n${YELLOW}=== RECON ===${NC}"
    find "$SCRIPT_DIR/recon" -type f -not -path "*/\.*" -not -path "*/screenshots/*" 2>/dev/null | sort | grep -i "$search_term" || true

    # Payloads, handlers and transfer
    echo -e "\n${YELLOW}=== ACCESS ===${NC}"
    find "$SCRIPT_DIR/access" -type f -not -path "*/\.*" 2>/dev/null | sort | grep -i "$search_term" || true

    # Attacker-side services
    echo -e "\n${YELLOW}=== INFRASTRUCTURE ===${NC}"
    find "$SCRIPT_DIR/infra" -type f -not -path "*/\.*" 2>/dev/null | sort | grep -i "$search_term" || true

    # Windows and AD
    echo -e "\n${YELLOW}=== WINDOWS ===${NC}"
    find "$SCRIPT_DIR/windows" -type f -not -path "*/\.*" 2>/dev/null | sort | grep -i "$search_term" || true

    # Cheatsheets and checklists
    echo -e "\n${YELLOW}=== DOCS ===${NC}"
    find "$SCRIPT_DIR/docs" -type f -not -path "*/\.*" 2>/dev/null | sort | grep -i "$search_term" || true

    echo -e "${GREEN}=================================================${NC}"
}

# Function to display detailed descriptions
function show_details() {
    local search_term="$1"

    echo -e "${GREEN}=================================================${NC}"
    echo -e "${GREEN}=  SCRIPT DETAILS                               =${NC}"
    echo -e "${GREEN}=================================================${NC}"

    # Names in CYAN are the command as published by setup_links -- basename
    # with the extension stripped. Where the file on disk differs, it is given
    # after the description.

    # Core Scripts
    echo -e "\n${YELLOW}CORE:${NC}"
    echo -e "${CYAN}aliases${NC} - The shell surface: \$IP and friends, plus the functions that use them. Sourced, not run"
    echo -e "${CYAN}scriptlist${NC} - This list"
    echo -e "${CYAN}setup_links${NC} - Symlink every executable in the repo into ~/.local/bin (-d to remove)"

    # Engagement State
    echo -e "\n${YELLOW}ENGAGEMENT STATE:${NC}"
    echo -e "${CYAN}target${NC} - Manage pentest project dirs, target state, and structured host notes (-F/-A/-H/-X)"
    echo -e "${CYAN}attack${NC} - Record your own interface and IP for the engagement (exports \$A_IP/\$A_DEV)"
    echo -e "${CYAN}setup_workspace${NC} - Build the tmux/i3 layout for the current target, with full pane logging"

    # Enumeration
    echo -e "\n${YELLOW}RECON:${NC}"
    echo -e "${CYAN}recon_sweep${NC} - External sweep over a domain: subdomains, screenshots, ports, vulns (recon_sweep.sh)"
    echo -e "${CYAN}port_scan${NC} - Bash /dev/tcp port scanner, no nmap needed (port_scan.sh)"
    echo -e "${CYAN}pingsweep${NC} - Sweep a range for live hosts (pingsweep.sh)"
    echo -e "${CYAN}enumcert${NC} - Dump a host TLS certificate; -l lists just the DNS names"
    echo -e "${CYAN}portlist${NC} - Turn an nmap .gnmap into a comma-separated port list. Used by my_scan"
    echo -e "${CYAN}run_all${NC} - Chain nmap, gobuster, nikto and enum4linux against one IP (run_all.sh)"
    echo -e "${CYAN}basic_portscan_bash${NC} - Emit a self-contained scanner to paste on a target"
    echo -e "${CYAN}ssh-username-enum${NC} - SSH username enumeration (ssh-username-enum.py)"
    echo -e "${CYAN}webscan${NC} - Screenshot a list of web targets with headless Chrome (web_scan/webscan.py)"
    echo -e "${CYAN}webcmd${NC} - Send URL-encoded commands to a command-injection endpoint (web_scan/webcmd)"
    echo -e "        ${NC}not published: basic_enum.sh / basic_enum.ps1 -- upload and run these on the target"

    # Access
    echo -e "\n${YELLOW}ACCESS:${NC}"
    echo -e "${CYAN}xfer_cmd${NC} - Generate scripted copy commands for Windows and Linux (xfer_cmd/xfer_cmd.py)"
    echo -e "${CYAN}msfhandler${NC} - Generate an msfconsole handler from LHOST/LPORT/arch/OS/protocol (msf_scripts/msfhandler.py)"
    echo -e "${CYAN}shell_upgrade${NC} - Upgrade a dumb shell to a fully interactive TTY (footholder/shell_upgrade)"
    echo -e "${CYAN}macro_formatter${NC} - Format a macro for embedding in an Office document"
    echo -e "${CYAN}check_macro${NC} - Verify the filename check baked into a macro doc, via olevba (check_macro.sh)"
    echo -e "${CYAN}create_proxy${NC} / ${CYAN}generate_phase0${NC} - Build the proxy stub and first-stage dropper"
    echo -e "        ${NC}msf_scripts/*.rc - ready-made handlers; see msf_scripts/README.md"

    # Infrastructure
    echo -e "\n${YELLOW}INFRASTRUCTURE:${NC}"
    echo -e "${CYAN}httpserve${NC} - Flask callback server: catches and logs exfil/callbacks to sqlite (webserver/httpserve.py)"
    echo -e "${CYAN}setup_www_tools${NC} - Stage the usual Windows tooling into /var/www/html/tools"
    echo -e "${CYAN}update_peas${NC} - Refresh the linPEAS/winPEAS binaries in \$PEAS_DIR (update_peas.sh)"
    echo -e "${CYAN}rsh_server${NC} - Start the reverse-ssh server"
    echo -e "${CYAN}setup_flask_server${NC} - Generate the cert the XSS collection server needs (xss_server/)"

    # Windows
    echo -e "\n${YELLOW}WINDOWS:${NC}"
    echo -e "${CYAN}add_rroot${NC} - Add a UID 0 account on Linux (users/add_rroot.sh)"
    echo -e "        ${NC}powershell/Spray-Passwords.ps1 - password spraying against a domain"
    echo -e "        ${NC}powershell/switchTo64.ps1 - re-launch a 32-bit PowerShell as 64-bit"
    echo -e "        ${NC}windows_domain/domainsetup.ps1 - stand up a lab domain controller"
    echo -e "        ${NC}log_analysis/log_search.psm1 - search Windows event logs"

    # Docs
    echo -e "\n${YELLOW}DOCS:${NC}"
    echo -e "${CYAN}common${NC} - Render the offline cheatsheets through glow. 'common' alone lists them"
    echo -e "        ${NC}common -t <name> imports a checklist into Taskwarrior"
    echo -e "        ${NC}docs/checklists/ - the longer-form checklists, in markdown and as a standalone page"

    echo -e "${GREEN}=================================================${NC}"
    echo -e "For full details, see the README.md file."
}

# Function to display a standard list of scripts
function show_standard_list() {
    local search_option="$1"
    local search_term="$2"
    # Array, not a bare word: TREE_OPTIONS is normally empty and a quoted empty
    # string would reach tree as a stray argument.
    local tree_opts=()
    [ -n "$search_option" ] && tree_opts=("$search_option")

    echo -e "${GREEN}=================================================${NC}"
    echo -e "${GREEN}=  Current script list                          =${NC}"
    echo -e "${GREEN}=================================================${NC}"

    if [ -z "$search_term" ]; then
        tree --noreport -I "README.md" -I "scriptlist" -I "venv" -I "attacker" -I "config" -I "setup_links" -I "legacy" "$SCRIPT_DIR/" "${tree_opts[@]}"
    else
        tree --noreport -I "README.md" -I "scriptlist" -I "venv" -I "attacker" -I "config" -I "setup_links" -I "legacy" "$SCRIPT_DIR/" "${tree_opts[@]}" | grep -i --color=always "$search_term"
    fi

    echo -e "${GREEN}=================================================${NC}"
}

# Parse command line options
SHOW_CATEGORIES=false
SHOW_DETAILS=false
SEARCH_TERM=""
TREE_OPTIONS=""

# Process options
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            ;;
        -v|--version)
            show_version
            ;;
        -c|--category)
            SHOW_CATEGORIES=true
            shift
            ;;
        -d|--details)
            SHOW_DETAILS=true
            shift
            ;;
        -f|--find)
            if [[ -n "$2" && "$2" != -* ]]; then
                SEARCH_TERM="$2"
                shift 2
            else
                echo -e "${RED}Error: --find requires a search term${NC}"
                exit 1
            fi
            ;;
        -*)
            echo -e "${RED}Unknown option: $1${NC}"
            echo "Use 'scriptlist --help' for usage information."
            exit 1
            ;;
        *)
            SEARCH_TERM="$1"
            shift
            ;;
    esac
done

# Execute the appropriate function based on options
if [ "$SHOW_CATEGORIES" = true ]; then
    show_by_category "$SEARCH_TERM"
elif [ "$SHOW_DETAILS" = true ]; then
    show_details "$SEARCH_TERM"
else
    show_standard_list "$TREE_OPTIONS" "$SEARCH_TERM"
fi
