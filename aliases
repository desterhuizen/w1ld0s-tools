function my_scan() {
    # Re-read the target state so a `target <ip>` run in this shell is picked
    # up here. (This used to source "${SOURCE_DIR}/target", which is a
    # directory -- it always failed, and $IP was whatever the shell started
    # with.)
    _target_source "${SOURCE_DIR}/target/config/targ.sh"
    if [ $# -eq 0 ]; then
        echo "Scan 1:  sudo nmap -sS -Pn -oA top_ports \$IP"
        echo "Scan 2:  sudo nmap -sVC -n -O -Pn -oA top_ports_version -p <portlist> \$IP"
        echo "Scan 3:  sudo nmap -sS -Pn -oA all_ports -p- --max-rtt-timeout=100ms \$IP"
        echo "Scan 4:  sudo nmap -sVC -A -R -O -Pn -oA all_ports_version  -p <portlist> \$IP"
        echo "Scan 5:  sudo nmap --script vuln -p <portlist> -oA vuln_scan  \$IP"
        echo "Scan 6:  sudo nmap -sU -Pn -oA udp_ports \$IP"
    else
        if [[ "$1" == "1" ]]; then
            echo "sudo nmap -sS -Pn -oA top_ports $IP $2"
            sudo nmap -sS -Pn -oA top_ports "$IP" "$2"
        elif [[ "$1" == "2" ]]; then
            echo "sudo nmap -sVC -n -O -Pn -oA top_ports_version -p $(cat top_ports.gnmap | portlist) $IP $2"
            sudo nmap -sVC -n -O -Pn -oA top_ports_version -p "$(cat top_ports.gnmap | portlist)" "$IP" "$2"
        elif [[ "$1" == "3" ]]; then
            echo "sudo nmap -sS -Pn -oA all_ports -p- --max-rtt-timeout=100ms $IP $2"
            sudo nmap -sS -Pn -oA all_ports -p- "$IP" "$2"
        elif [[ "$1" == "4" ]]; then
            echo "sudo nmap -sVC -A -R -O -Pn -oA all_ports_version -p $(cat all_ports.gnmap | portlist) $IP $2"
            sudo nmap -sVC -A -R -O -Pn -oA all_ports_version -p "$(cat all_ports.gnmap | portlist)" "$IP" "$2"
        elif [[ "$1" == "5" ]]; then
            echo "sudo nmap --script vuln -p $(cat top_ports.gnmap | portlist) $IP -oA vuln_scan $2"
            sudo nmap --script vuln -p "$(cat top_ports.gnmap | portlist)" "$IP" -oA vuln_scan "$2"
        elif [[ "$1" == "6" ]]; then
            echo "sudo nmap -sU -Pn -oA udp_port $IP $2"
            sudo nmap -sU -Pn -oA udp_port "$IP" "$2"
        fi
    fi
}

