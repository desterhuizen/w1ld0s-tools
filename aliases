#!/bin/bash
#
# Penetration Testing Aliases and Functions
#
# Loader. The aliases and functions themselves live in aliases.d/; this file
# only locates them and sources them in order.
#
# Source this file from your .bashrc or .zshrc:
#     source ~/tools/repos/w1ld0s-tools/aliases
#
# Fail-safe: this runs at interactive shell startup, so a missing or
# unreadable file must never abort the shell. The explicit `return 0` in
# _target_source is load-bearing -- without it a false `[ -r ]` leaks a
# non-zero status out of the function and can kill the rc file.
#
# Self-locating: $W1LD0S_TOOLS_DIR wins so a checkout anywhere still works,
# otherwise fall back to where w1ld0s module 90 clones this repo.
#
# $_W1LD0S_DIR and _target_source are this loader's interface to the fragments:
# both are read from aliases.d/ (00-state.sh, 10-recon.sh) and so must outlive
# this file, under a name unlikely to collide with anything else sourced into
# the same shell.
_W1LD0S_DIR="${W1LD0S_TOOLS_DIR:-${HOME}/tools/repos/w1ld0s-tools}"
# shellcheck source=/dev/null  # path is runtime-determined
_target_source() { [ -r "$1" ] && . "$1"; return 0; }

# Fragments are listed by name rather than globbed. Two reasons: zsh errors on
# a glob that matches nothing where bash leaves the pattern literal, and this
# file must not produce so much as a warning at shell startup; and load order
# is a real dependency -- 00-state.sh exports the variables the rest read.
#
# Adding a fragment means adding it here.
for _tf in 00-state 10-recon 20-access 30-infra 40-tunnels 50-time 60-research 90-shell; do
    _target_source "${_W1LD0S_DIR}/aliases.d/${_tf}.sh"
done
unset _tf
