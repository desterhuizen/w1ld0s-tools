function httptools() {
    dev='tun0'
    if [ $# -ne 0 ]; then
        dev="$1"
    fi
    SELF_IP=$(ip -br addr show | grep "$dev" | awk -F" " '{print $3}' | cut -d "/" -f1)
    find /var/www/html/tools -maxdepth 1 -mindepth 1 -printf '%f\n' | sort |
        awk -v ip="$SELF_IP" '{print "http://" ip "/tools/" $0}' | grep -Ev '[\./]$'
}

function serve() {
    port=80
    dev=tun0

    if [[ "$2" == "eth0" || "$2" == "tun0" ]]; then
        dev="$2"
    fi

    IP=$(ip -br addr show | grep "$dev" | awk -F" " '{print $3}' | cut -d "/" -f1)

    if [[ $# -eq 1 ]]; then
        if [[ "$1" == "peas" ]]; then
            find "${HOME}/tools/peas/" -maxdepth 1 -mindepth 1 -printf '%f\n' | sort |
                while read -r peas_file; do echo "http://$IP/$peas_file"; done
            python3 -m http.server "$port" --directory "${HOME}/tools/peas/"
        else
            port="$1"
        fi
    fi

    python3 -m http.server "$port"
}

# =============================================================================
# HOST MANAGEMENT
# =============================================================================

function set_host() {
    if grep -q "$1" /etc/hosts; then
        sudo sed -i "s/$(grep "$1" /etc/hosts | cut -d ' ' -f 1)/$2/g" /etc/hosts
    else
        echo "$2  $1" | sudo tee -a /etc/hosts
    fi
}

function unset_host() {
    if grep -q "$1" /etc/hosts; then
        sudo sed -i "/\s$1$/d" /etc/hosts
    fi
}

function monitor_host() {
    while true; do
        clear
        date
        echo -e '\n ========================\n'
        ping "$1" -c 1 | grep -E '[01] packets|[01] received'
        echo -e '\n ========================'
        sleep 5
    done
}

