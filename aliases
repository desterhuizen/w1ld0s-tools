# =============================================================================

function rscp() {
    ip=$(ip -4 addr show dev tun0 | grep inet | cut -d'/' -f1 | awk '{print $2}')
    scp -J "$ip" "$@"
}

function rssh() {
    port=443
    if [ $# -ne 0 ]; then
        port="$1"
    fi
    ip=$(ip -4 addr show dev tun0 | grep inet | cut -d'/' -f1 | awk '{print $2}')
    ssh "$ip" -p "$port"
}

function rsh_links() {
    port=443
    if [ $# -eq 2 ]; then
        port="$2"
    fi
    ssh "$1" -p "$port" "link -r *"
    ssh "$1" -p "$port" "link --goos windows --goarch amd64 --name shell.exe"
    ssh "$1" -p "$port" "link --goos linux --goarch amd64 --name shell"
    ssh "$1" -p "$port" "link -l"
}

