# Source configuration files.
#
# These used to point at target/targ, target/base and target/name -- 0-byte
# placeholders that nothing ever wrote, so $IP and friends were never actually
# exported. The state lives in target/config/*.sh, written by `target`.
#
# Fail-safe: this runs at interactive shell startup, so a missing or
# unreadable file must never abort the shell. The explicit `return 0` is
# load-bearing -- without it a false `[ -r ]` leaks a non-zero status out of
# the function and can kill the rc file.
#
# Self-locating: $W1LD0S_TOOLS_DIR wins so a checkout anywhere still works,
# otherwise fall back to where w1ld0s module 90 clones this repo.
SOURCE_DIR="${W1LD0S_TOOLS_DIR:-${HOME}/tools/repos/w1ld0s-tools}"
# shellcheck source=/dev/null  # path is runtime-determined
_target_source() { [ -r "$1" ] && . "$1"; return 0; }
for _tf in targ base name lab vpn; do
    _target_source "${SOURCE_DIR}/target/config/${_tf}.sh"
done
unset _tf
_target_source "${SOURCE_DIR}/attack/attacker"

